# PostgreSQL obligatorio (Vercel no permite archivos SQLite).
# Crea una base gratis en https://console.neon.tech y usa su "Connection string".
# La MISMA DATABASE_URL va en tu archivo .env local y en las variables de
# entorno de Vercel. Ejemplo:
#   DATABASE_URL="postgresql://user:pass@ep-xxx-xxx.neon.tech/neondb?sslmode=require"
# Deja vacía para usar el modo demo (respuestas de ejemplo sin llamar a OpenAI).
DATABASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EVALUATOR_MODEL="gpt-4o-mini"